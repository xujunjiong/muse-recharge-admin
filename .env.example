# npm run setup 写入管理员密码哈希。不要提交 .env。
ADMIN_PASSWORD_HASH=
PORT=3000
# 默认只监听 127.0.0.1，通过 SSH 隧道访问。
# 若使用 HTTPS 反向代理，设置完整 origin 并启用安全 cookie。
APP_ORIGIN=
COOKIE_SECURE=false
DATABASE_FILE=data/muse.sqlite
# mock 不加载 Telegram、不产生真实付款。开发或演示使用独立数据库。
BOT_MODE=mock
LIVE_PAYMENTS_ENABLED=NO
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_FILE=data/telegram.session
# 已观察的 Satu Digital 机器人 ID，启动时核验，不能仅凭 username 交易。
TELEGRAM_BOT_ID=8647262682

# 网页登录保存的凭据与会话，仅后端读取，禁止提交 GitHub。
TELEGRAM_LOGIN_FILE=data/telegram-login.json
