{
  "name": "muse-recharge-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild web/main.tsx --bundle --minify --outfile=public/app.js --loader:.css=css",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "login:telegram": "tsx scripts/telegram-login.ts",
    "probe:telegram": "tsx scripts/telegram-probe.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "telegram": "2.26.22",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
